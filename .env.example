# Mercado Pago. Access Token de la aplicación (prueba o producción).
# Nunca lo expongas en el cliente ni lo pongas en una variable NEXT_PUBLIC_.
MERCADOPAGO_ACCESS_TOKEN=

# Secret de la firma de webhooks (Tus integraciones → Webhooks → revelar secret).
MERCADOPAGO_WEBHOOK_SECRET=

# true fuerza sandbox_init_point. También se activa solo si el token empieza con TEST-.
MERCADOPAGO_SANDBOX=false

# Supabase. La service role solo vive en el servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Bucket privado y ruta del PDF del ebook destacado (ia-para-docentes).
# Dejalos vacíos para servir el PDF marcador que está en private/ebook.
# Cuando subas el libro: ebooks / ia-para-docentes.pdf
# Los otros ebooks del catálogo usan su propia ruta cuando estén a la venta.
EBOOK_STORAGE_BUCKET=
EBOOK_STORAGE_PATH=

# Resend. EMAIL_FROM tiene que ser un remitente del dominio verificado.
# El nombre visible queda fijo en Cerebrika, aunque acá pongas solo el correo.
RESEND_API_KEY=
EMAIL_FROM=Cerebrika <hola@tudominio.com>

# URL pública del sitio, sin barra final.
# Local: http://127.0.0.1:3457
# Producción: https://tu-dominio
SITE_URL=http://127.0.0.1:3457

# Precio entero en pesos argentinos del ebook destacado.
# Si está definido, pisa el precio del catálogo de ia-para-docentes.
# 12000 es un ejemplo de configuración, no un tipo de cambio.
PRICE_ARS=12000

# Horas de validez del enlace de descarga que llega por mail.
DOWNLOAD_TTL_HOURS=72

# WhatsApp con código de país, solo dígitos (54911...). Vacío = no se muestra el botón.
WHATSAPP_NUMBER=

# Píxel de Meta (solo el id numérico, lo ves en el Administrador de eventos).
# Vacío = no se carga nada de Meta. Es NEXT_PUBLIC: si lo cambiás, volvé a desplegar.
NEXT_PUBLIC_META_PIXEL_ID=

# Mail que recibe los pedidos del Botón de arrepentimiento (tu casilla de soporte).
SUPPORT_EMAIL=
